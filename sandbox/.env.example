# Copy to sandbox/.env and fill in. The .env file is gitignored.

# Required — your local Daytona API key. Generate one from the Daytona
# dashboard at http://localhost:3000.
DAYTONA_API_KEY=dtn_...

# Optional — override the default Daytona endpoint.
# DAYTONA_API_URL=http://localhost:3000/api

# Optional — pin a default snapshot version. Equivalent to passing it as
# the first positional arg to build-snapshot.ts / run-sandbox.ts.
# FUCC_SNAPSHOT_VERSION=v1

# Optional — point a self-hosted Langfuse (running on your tailnet) through
# a caddy reverse-proxy on the host. See sandbox/README.md ("Reaching tailnet
# services") for the matching `caddy reverse-proxy` invocation.
# LANGFUSE_HOST=http://host.docker.internal:3004
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
